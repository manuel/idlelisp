(module
(defclass List)

(defclass Nil (List))

(defclass Node (List)
  (next $List))

(defgeneric $is-empty ((list $List) i32))
(defgeneric $tail ((list $List) $List))

(defmethod $is-empty ((list $List) i32)
  (i32.const 1))

(defmethod $tail ((list $List) $List)
  $list)

(defmethod $is-empty ((list $Node) i32)
  (i32.const 0))

(defmethod $tail ((list $Node) $List)
  (classes:get Node next $list))

(defun $build (($size i32) $List)
  (let $remaining i32 $size)
  (let $list $List ($Nil.new))
  (block $build.done
    (loop $build.again
      (br_if $build.done (i32.eqz (local.get $remaining)))
      (local.set $list (call $Node.new (local.get $list)))
      (local.set $remaining
        (i32.sub (local.get $remaining) (i32.const 1)))
      (br $build.again)))
  (local.get $list))

(defun $count (($list $List) i32)
  (let $length i32 (i32.const 0))
  (let $cursor $List $list)
  (block $count.done
    (loop $count.again
      (br_if $count.done (call $is-empty (local.get $cursor)))
      (local.set $cursor (call $tail (local.get $cursor)))
      (local.set $length
        (i32.add (local.get $length) (i32.const 1)))
      (br $count.again)))
  (local.get $length))

(defun $build-and-count (($size i32) i32)
  (call $count (call $build (local.get $size))))

(export-func build)
(export-func count)
(export-func build-and-count)
)

(module
(defclass List)

(defclass Nil (List))

(defclass Node (List)
  (next List))

(defgeneric $is-empty ((list List) i32))
(defgeneric $tail ((list List) List))

(defmethod $is-empty ((list List) i32)
  (i32.const 1))

(defmethod $tail ((list List) List)
  $list)

(defmethod $is-empty ((list Node) i32)
  (i32.const 0))

(defmethod $tail ((list Node) List)
  (classes:get Node next $list))

(typed-defun $build (($size i32) List)
  (let $remaining i32 $size)
  (let $list List ($Nil.new))
  (while $remaining
    (set $list ($Node.new $list))
    (set $remaining (i32.sub $remaining 1)))
  $list)

(typed-defun $count (($list List) i32)
  (let $length i32 0)
  (let $cursor List $list)
  (while (i32.eqz ($is-empty $cursor))
    (set $cursor ($tail $cursor))
    (set $length (i32.add $length 1)))
  $length)

(typed-defun $build-and-count (($size i32) i32)
  ($count ($build $size)))

(export-func build)
(export-func count)
(export-func build-and-count)
)

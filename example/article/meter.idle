(module
  (class Meter
    (field value i32)
    (method reading ()
      (result i32)
      (classes:get Meter value $this)))

  (class CalibratedMeter
    (extends Meter)
    (field correction i32)
    (override reading ()
      (result i32)
      (demo:double
        (i32.add
          (classes:super-call CalibratedMeter reading $this)
          (classes:get CalibratedMeter correction $this)))))

  (typed-defun $main (i32)
    (let $meter Meter
      ($CalibratedMeter.new 17 5))
    (.reading $meter))

  (export-func main))
